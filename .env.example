# Modelo de variáveis de ambiente. Copie para .env e preencha.
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.
#
# Uso local (Docker Compose já injeta esses valores; use este arquivo apenas se rodar
# a app manualmente ou com `docker run --env-file .env`).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=togglemaster
DB_USER=user
DB_PASSWORD=password
