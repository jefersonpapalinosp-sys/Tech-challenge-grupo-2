# Copie para terraform.tfvars e ajuste. terraform.tfvars NÃO deve ser versionado.
# Alternativa mais segura para a senha: export TF_VAR_db_password="..."

region        = "us-east-1"
project_name  = "togglemaster"
instance_type = "t3.micro"

# Key Pair EXISTENTE na AWS para SSH (crie antes no console EC2 > Key Pairs).
# Deixe "" para não habilitar SSH por chave.
key_name = ""

# Restrinja o SSH ao seu IP. Descubra em https://checkip.amazonaws.com
allowed_ssh_cidr = "0.0.0.0/0"

# URL pública do repositório (a EC2 vai cloná-lo para buildar a imagem).
repo_url = "https://github.com/jefersonpapalinosp-sys/Tech-challenge-grupo-2.git"

# Banco
db_name     = "togglemaster"
db_username = "postgres"
# db_password = "defina-uma-senha-forte"   # prefira TF_VAR_db_password
